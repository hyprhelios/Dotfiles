{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/assets/fastfetch.png",
    "type": "auto",
    "padding": {
      "top": 2,
      "left": 2
    },
    "width": 14
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "green",
        "at": "white",
        "host": "cyan"
      }
    },
    {
      "type": "os",
      "key": "    \u001b[36m├─\u001b[0m \u001b[31m󰣇\u001b[0m",
      "format": " {3}"
    },
    {
      "type": "kernel",
      "key": "    \u001b[36m├─\u001b[0m \u001b[31m\u001b[0m",
      "format": " {1} {2}"
    },
    {
      "type": "packages",
      "key": "    \u001b[36m├─\u001b[0m \u001b[31m\u001b[0m",
      "format": " {1} (pacman)"
    },
    {
      "type": "shell",
      "key": "    \u001b[36m└─\u001b[0m \u001b[31m\u001b[0m",
      "format": " {1}"
    },
    { "type": "custom", "format": "" },
    {
      "type": "wm",
      "key": "    \u001b[36m├─\u001b[0m \u001b[31m\u001b[0m",
      "format": " {3}"
    },
    {
      "type": "terminal",
      "key": "    \u001b[36m├─\u001b[0m \u001b[31m\u001b[0m",
      "format": " {1}"
    },
    {
      "type": "terminalfont",
      "key": "    \u001b[36m└─\u001b[0m \u001b[31m\u001b[0m",
      "format": " {1}"
    },
    { "type": "custom", "format": "" },
    {
      "type": "host",
      "key": "    \u001b[36m─\u001b[0m \u001b[31m󰌢\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "    \u001b[36m├─\u001b[0m \u001b[31m\u001b[0m",
      "format": " {1}"
    },
    {
      "type": "memory",
      "key": "    \u001b[36m├─\u001b[0m \u001b[31m\u001b[0m",
      "format": " {1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": "    \u001b[36m└─\u001b[0m \u001b[31m󰋊\u001b[0m",
      "format": " {1} / {2} ({3}) - {5}",
      "folders": "/"
    },
    { "type": "custom", "format": "" },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
