{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/assets/fastfetch.png",
    "type": "auto",
    "padding": {
      "top": 2,
      "left": 2
    },
    "width": 14
  },
  "display": {
    "separator": " ",
    "color": {
      "output": "green"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "green",
        "at": "white",
        "host": "cyan"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[32m------------------------------------------\u001b[0m"
    },
    // --- SECCIÓN OS ---
    {
      "type": "os",
      "key": "\u001b[36m󰣇 OS   \u001b[36m├─ \u001b[31m󰣇 \u001b[31m󰁔\u001b[0m",
      "format": "{3}"
    },
    {
      "type": "kernel",
      "key": "\u001b[36m       ├─ \u001b[31m \u001b[31m󰁔\u001b[0m"
    },
    {
      "type": "packages",
      "key": "\u001b[36m       ├─ \u001b[31m \u001b[31m󰁔\u001b[0m",
      "format": "{1} (pacman)"
    },
    {
      "type": "shell",
      "key": "\u001b[36m       └─ \u001b[31m \u001b[31m󰁔\u001b[0m"
    },
    { "type": "custom", "format": "\u001b[36m\u001b[0m" }, // Espacio simple
    // --- SECCIÓN WM ---
    {
      "type": "wm",
      "key": "\u001b[36m WM   \u001b[36m├─ \u001b[31m \u001b[31m󰁔\u001b[0m"
    },
    {
      "type": "terminal",
      "key": "\u001b[36m       ├─ \u001b[31m \u001b[31m󰁔\u001b[0m"
    },
    {
      "type": "terminalfont",
      "key": "\u001b[36m       └─ \u001b[31m \u001b[31m󰁔\u001b[0m"
    },
    { "type": "custom", "format": "\u001b[36m\u001b[0m" },
    // --- SECCIÓN PC ---
    {
      "type": "host",
      "key": "\u001b[36m PC   \u001b[36m├─ \u001b[31m󰌢 \u001b[31m󰁔\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\u001b[36m       ├─ \u001b[31m \u001b[31m󰁔\u001b[0m"
    },
    {
      "type": "memory",
      "key": "\u001b[36m       ├─ \u001b[31m \u001b[31m󰁔\u001b[0m",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": "\u001b[36m       └─ \u001b[31m󰋊 \u001b[31m󰁔\u001b[0m",
      "folders": "/"
    },
    // --- RELLENO PARA EXTENDER VERTICALMENTE ---
    // Añadimos líneas vacías con la rama vertical para que coincida con la altura de la imagen
    { "type": "custom", "format": "" }, 
    { "type": "custom", "format": "" },
    { "type": "custom", "format": "" },
    { "type": "custom", "format": "" },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
