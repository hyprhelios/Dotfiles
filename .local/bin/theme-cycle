#!/usr/bin/env bash
set -euo pipefail

THEMES=("barch" "img1084" "7ucM1Zw")
STATE_FILE="$HOME/.local/share/dots-hyprland/themes/.current"
WALLPAPER_DIR="$HOME/.local/share/dots-hyprland/wallpapers"
THEME_DIR="$HOME/.local/share/dots-hyprland/themes"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"

declare -A WALLPAPERS=(
    ["barch"]="barch.png"
    ["img1084"]="IMG_1084.png"
    ["7ucM1Zw"]="7ucM1Zw.png"
)

declare -A LABELS=(
    ["barch"]="Barch"
    ["img1084"]="IMG 1084"
    ["7ucM1Zw"]="7ucM1Zw"
)

exec 9>"$RUNTIME_DIR/theme-cycle-$UID.lock"
flock -n 9 || exit 0

CURRENT=""
if [ -f "$STATE_FILE" ]; then
    CURRENT="$(<"$STATE_FILE")"
fi

case "${1:-}" in
    --current) NEXT="$CURRENT" ;;
    "")
        NEXT="${THEMES[0]}"
        for i in "${!THEMES[@]}"; do
            if [ "${THEMES[$i]}" = "$CURRENT" ]; then
                NEXT="${THEMES[$(( (i + 1) % ${#THEMES[@]} ))]}"
                break
            fi
        done
        ;;
    barch|img1084|7ucM1Zw) NEXT="$1" ;;
    *)
        printf 'Usage: %s [--current|barch|img1084|7ucM1Zw]\n' "$0" >&2
        exit 2
        ;;
esac

if [ -z "$NEXT" ]; then
    NEXT="${THEMES[0]}"
fi

THEME_PATH="$THEME_DIR/$NEXT"
COLORS_PATH="$THEME_PATH/colors.json"
WALLPAPER_PATH="$WALLPAPER_DIR/${WALLPAPERS[$NEXT]}"

for file in "$COLORS_PATH" "$THEME_PATH/gtk.css" "$THEME_PATH/fuzzel_theme.ini" "$WALLPAPER_PATH"; do
    if [ ! -f "$file" ]; then
        printf 'Required theme file not found: %s\n' "$file" >&2
        exit 1
    fi
done

python3 - "$COLORS_PATH" "$WALLPAPER_PATH" "$THEME_PATH/gtk.css" <<'PY'
import json
import os
import sys
from pathlib import Path

colors_path, wallpaper, gtk4_source = sys.argv[1:]
home = Path.home()
wallpaper_path = Path(wallpaper)
try:
    wallpaper_config = "~/" + str(wallpaper_path.relative_to(home))
except ValueError:
    wallpaper_config = str(wallpaper_path)
with open(colors_path, encoding="utf-8") as handle:
    colors = json.load(handle)

def color(name):
    return colors[name]

def bare(name):
    return color(name).removeprefix("#")

def write(path, content):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.write_text(content.rstrip() + "\n", encoding="utf-8")
    os.replace(temporary, path)

write(home / ".config/hypr/theme.conf", f"""
# Generated by theme-cycle. Do not edit.
general:col.active_border = rgba({bare('primary')}ee) rgba({bare('secondary')}ee) 45deg
general:col.inactive_border = rgba({bare('outline_variant')}aa)
misc:background_color = rgb({bare('background')})
""")

write(home / ".config/hypr/hyprlock/colors.conf", f"""
# Generated by theme-cycle. Do not edit.
$text_color = rgba({bare('on_background')}FF)
$subtext_color = rgba({bare('on_surface_variant')}FF)
$background_color = rgba({bare('background')}FF)
$entry_background_color = rgba({bare('surface_container_high')}DD)
$entry_border_color = rgba({bare('primary')}EE) rgba({bare('secondary')}EE) 45deg
$entry_check_color = rgba({bare('secondary')}EE)
$entry_fail_color = rgba({bare('error')}EE)
$entry_capslock_color = rgba({bare('tertiary')}EE)
$entry_color = rgba({bare('on_surface')}FF)
$shadow_color = rgba({bare('shadow')}88)
$font_family = Google Sans Flex Medium
$font_family_clock = Google Sans Flex Medium
$background_image = {wallpaper_config}
""")

palette = [
    color("surface_container_lowest"), color("error"), color("secondary"),
    color("tertiary"), color("primary"), color("tertiary_fixed_dim"),
    color("secondary_fixed_dim"), color("on_surface_variant"),
    color("outline_variant"), color("error"), color("secondary_fixed_dim"),
    color("tertiary_fixed_dim"), color("primary_fixed_dim"),
    color("tertiary_fixed"), color("secondary_fixed"), color("on_surface"),
]
ghostty = f"""
# Generated by theme-cycle. Do not edit.
background = {color('background')}
foreground = {color('on_background')}
cursor-color = {color('primary')}
cursor-text = {color('on_primary')}
selection-background = {color('primary_container')}
selection-foreground = {color('on_primary_container')}
"""
ghostty += "\n".join(f"palette = {index}={value}" for index, value in enumerate(palette))
write(home / ".config/ghostty/theme", ghostty)

write(home / ".config/gtk-3.0/gtk.css", f"""
/* Generated by theme-cycle for GTK 3. */
@define-color accent_color {color('primary')};
@define-color accent_fg_color {color('on_primary')};
@define-color accent_bg_color {color('primary')};
@define-color destructive_bg_color {color('error_container')};
@define-color destructive_fg_color {color('on_error_container')};
@define-color destructive_color {color('error')};
@define-color window_bg_color {color('background')};
@define-color window_fg_color {color('on_background')};
@define-color headerbar_bg_color {color('surface_container')};
@define-color headerbar_backdrop_color {color('surface_container')};
@define-color headerbar_fg_color {color('on_surface')};
@define-color card_bg_color {color('surface_container')};
@define-color card_fg_color {color('on_surface')};
@define-color sidebar_bg_color {color('surface_container')};
@define-color sidebar_fg_color {color('on_surface')};
@define-color secondary_sidebar_bg_color {color('surface_container_low')};
@define-color secondary_sidebar_fg_color {color('on_surface_variant')};
@define-color sidebar_border_color @sidebar_bg_color;
@define-color sidebar_backdrop_color @sidebar_bg_color;
@define-color view_bg_color {color('surface_container_lowest')};
@define-color view_fg_color {color('on_surface')};
@define-color popover_bg_color {color('surface_container_highest')};
@define-color popover_fg_color {color('on_surface')};
@define-color dialog_bg_color {color('surface_container_high')};
@define-color dialog_fg_color {color('on_surface')};
""")

gtk4 = Path(gtk4_source).read_text(encoding="utf-8")
dark_marker = "@media (prefers-color-scheme: dark) {"
dark_start = gtk4.find(dark_marker)
if dark_start == -1:
    raise ValueError(f"Dark GTK palette not found in {gtk4_source}")
dark_start += len(dark_marker)
dark_end = gtk4.find("\n}", dark_start)
gtk4 = gtk4[dark_start:dark_end].strip() + "\n\n" + gtk4[dark_end + 2:].lstrip()
gtk4 = gtk4.replace("opacity: 100%;", "opacity: 1;").replace(":insensitive", ":disabled")
gtk4 = gtk4.replace("@popover_fg_active_color", "@popover_fg_hover_color")
write(home / ".config/gtk-4.0/gtk.css", gtk4)

write(home / ".config/wofi/style.css", f"""
/* Generated by theme-cycle. */
@define-color background {color('background')};
@define-color surface {color('surface_container')};
@define-color surface_high {color('surface_container_high')};
@define-color text {color('on_background')};
@define-color subtext {color('on_surface_variant')};
@define-color primary {color('primary')};
@define-color primary_container {color('primary_container')};
@define-color on_primary_container {color('on_primary_container')};

* {{
    font-family: "CaskaydiaCove Nerd Font", monospace;
    font-size: 16px;
}}

window {{
    background-color: @background;
    border: 2px solid @primary;
    border-radius: 12px;
}}

#outer-box, #inner-box, #scroll {{
    background-color: transparent;
    padding: 8px;
}}

#input {{
    margin: 6px;
    padding: 10px 12px;
    color: @text;
    background-color: @surface_high;
    border: 1px solid @primary;
    border-radius: 10px;
}}

#entry {{
    padding: 8px;
    background-color: transparent;
    border-radius: 8px;
}}

#entry:selected {{
    background-color: @primary_container;
}}

#text {{ color: @text; }}
#entry:selected #text {{ color: @on_primary_container; }}
""")

write(home / ".local/state/quickshell/user/generated/color.txt", color("primary"))
PY

cp "$THEME_PATH/fuzzel_theme.ini" "$HOME/.config/fuzzel/fuzzel_theme.ini"

gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark'

"$HOME/.local/bin/set-wallpaper" "$WALLPAPER_PATH"
"$HOME/.local/bin/update-waybar-theme" "$COLORS_PATH"
printf '%s\n' "$NEXT" > "$STATE_FILE"

hyprctl reload >/dev/null
pkill -USR2 -x ghostty 2>/dev/null || true
swaync-client --reload-css >/dev/null 2>&1 || true

notify-send -i "$WALLPAPER_PATH" "Theme" "Tema: ${LABELS[$NEXT]}" -t 2000
